{
  "terraform": {
    "required_version": ">= 1.6",
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 5.0"
      }
    }
  },
  "provider": {
    "aws": {
      "region": "${var.region}"
    }
  },
  "variable": {
    "region": {
      "default": "us-east-1"
    },
    "azs": {
      "type": "list(string)",
      "default": [
        "us-east-1a",
        "us-east-1b"
      ]
    },
    "certificate_arn": {
      "type": "string"
    },
    "app_origin": {
      "type": "string",
      "default": "https://staging.thebestpilaf.com"
    },
    "image": {
      "type": "string",
      "default": ""
    },
    "enable_service": {
      "type": "bool",
      "default": false
    }
  },
  "resource": {
    "aws_vpc": {
      "main": {
        "cidr_block": "10.42.0.0/16",
        "enable_dns_support": true,
        "enable_dns_hostnames": true
      }
    },
    "aws_internet_gateway": {
      "main": {
        "vpc_id": "${aws_vpc.main.id}"
      }
    },
    "aws_subnet": {
      "public0": {
        "vpc_id": "${aws_vpc.main.id}",
        "cidr_block": "10.42.1.0/24",
        "availability_zone": "${var.azs[0]}",
        "map_public_ip_on_launch": false
      },
      "private0": {
        "vpc_id": "${aws_vpc.main.id}",
        "cidr_block": "10.42.11.0/24",
        "availability_zone": "${var.azs[0]}",
        "map_public_ip_on_launch": false
      },
      "public1": {
        "vpc_id": "${aws_vpc.main.id}",
        "cidr_block": "10.42.2.0/24",
        "availability_zone": "${var.azs[1]}",
        "map_public_ip_on_launch": false
      },
      "private1": {
        "vpc_id": "${aws_vpc.main.id}",
        "cidr_block": "10.42.12.0/24",
        "availability_zone": "${var.azs[1]}",
        "map_public_ip_on_launch": false
      }
    },
    "aws_route_table": {
      "public": {
        "vpc_id": "${aws_vpc.main.id}",
        "route": [
          {
            "cidr_block": "0.0.0.0/0",
            "gateway_id": "${aws_internet_gateway.main.id}"
          }
        ]
      },
      "private": {
        "vpc_id": "${aws_vpc.main.id}",
        "route": [
          {
            "cidr_block": "0.0.0.0/0",
            "nat_gateway_id": "${aws_nat_gateway.main.id}"
          }
        ]
      }
    },
    "aws_route_table_association": {
      "public0": {
        "subnet_id": "${aws_subnet.public0.id}",
        "route_table_id": "${aws_route_table.public.id}"
      },
      "public1": {
        "subnet_id": "${aws_subnet.public1.id}",
        "route_table_id": "${aws_route_table.public.id}"
      },
      "private0": {
        "subnet_id": "${aws_subnet.private0.id}",
        "route_table_id": "${aws_route_table.private.id}"
      },
      "private1": {
        "subnet_id": "${aws_subnet.private1.id}",
        "route_table_id": "${aws_route_table.private.id}"
      }
    },
    "aws_eip": {
      "nat": {
        "domain": "vpc"
      }
    },
    "aws_nat_gateway": {
      "main": {
        "allocation_id": "${aws_eip.nat.id}",
        "subnet_id": "${aws_subnet.public0.id}",
        "depends_on": [
          "aws_internet_gateway.main"
        ]
      }
    },
    "aws_security_group": {
      "alb": {
        "name": "pilaf-staging-alb",
        "vpc_id": "${aws_vpc.main.id}",
        "egress": [
          {
            "from_port": 0,
            "to_port": 0,
            "protocol": "-1",
            "cidr_blocks": [
              "0.0.0.0/0"
            ]
          }
        ]
      },
      "app": {
        "name": "pilaf-staging-app",
        "vpc_id": "${aws_vpc.main.id}",
        "egress": [
          {
            "from_port": 0,
            "to_port": 0,
            "protocol": "-1",
            "cidr_blocks": [
              "0.0.0.0/0"
            ]
          }
        ]
      },
      "db": {
        "name": "pilaf-staging-db",
        "vpc_id": "${aws_vpc.main.id}",
        "egress": [
          {
            "from_port": 0,
            "to_port": 0,
            "protocol": "-1",
            "cidr_blocks": [
              "0.0.0.0/0"
            ]
          }
        ]
      }
    },
    "aws_security_group_rule": {
      "alb443": {
        "security_group_id": "${aws_security_group.alb.id}",
        "type": "ingress",
        "from_port": 443,
        "to_port": 443,
        "protocol": "tcp",
        "cidr_blocks": [
          "0.0.0.0/0"
        ]
      },
      "alb80": {
        "security_group_id": "${aws_security_group.alb.id}",
        "type": "ingress",
        "from_port": 80,
        "to_port": 80,
        "protocol": "tcp",
        "cidr_blocks": [
          "0.0.0.0/0"
        ]
      },
      "app3000": {
        "security_group_id": "${aws_security_group.app.id}",
        "type": "ingress",
        "from_port": 3000,
        "to_port": 3000,
        "protocol": "tcp",
        "source_security_group_id": "${aws_security_group.alb.id}"
      },
      "db5432": {
        "security_group_id": "${aws_security_group.db.id}",
        "type": "ingress",
        "from_port": 5432,
        "to_port": 5432,
        "protocol": "tcp",
        "source_security_group_id": "${aws_security_group.app.id}"
      }
    },
    "aws_db_subnet_group": {
      "main": {
        "name": "pilaf-staging",
        "subnet_ids": [
          "${aws_subnet.private0.id}",
          "${aws_subnet.private1.id}"
        ]
      }
    },
    "aws_db_instance": {
      "main": {
        "identifier": "pilaf-staging",
        "engine": "postgres",
        "engine_version": "16",
        "instance_class": "db.t4g.micro",
        "allocated_storage": 20,
        "max_allocated_storage": 100,
        "storage_encrypted": true,
        "db_name": "pilaf",
        "username": "pilafadmin",
        "manage_master_user_password": true,
        "db_subnet_group_name": "${aws_db_subnet_group.main.name}",
        "vpc_security_group_ids": [
          "${aws_security_group.db.id}"
        ],
        "publicly_accessible": false,
        "backup_retention_period": 14,
        "deletion_protection": true,
        "skip_final_snapshot": false,
        "final_snapshot_identifier": "pilaf-staging-final"
      }
    },
    "aws_ecr_repository": {
      "main": {
        "name": "thebestpilaf-staging",
        "image_tag_mutability": "IMMUTABLE",
        "image_scanning_configuration": {
          "scan_on_push": true
        }
      }
    },
    "aws_secretsmanager_secret": {
      "dburl": {
        "name": "thebestpilaf/staging/database-url"
      }
    },
    "aws_cloudwatch_log_group": {
      "main": {
        "name": "/ecs/thebestpilaf-staging",
        "retention_in_days": 30
      }
    },
    "aws_ecs_cluster": {
      "main": {
        "name": "thebestpilaf-staging"
      }
    },
    "aws_iam_role": {
      "execution": {
        "name": "pilaf-staging-execution",
        "assume_role_policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Principal\": {\"Service\": \"ecs-tasks.amazonaws.com\"}, \"Action\": \"sts:AssumeRole\"}]}"
      }
    },
    "aws_iam_role_policy_attachment": {
      "execution": {
        "role": "${aws_iam_role.execution.name}",
        "policy_arn": "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
      }
    },
    "aws_iam_role_policy": {
      "secret": {
        "role": "${aws_iam_role.execution.name}",
        "policy": "${jsonencode({Version=\"2012-10-17\",Statement=[{Effect=\"Allow\",Action=[\"secretsmanager:GetSecretValue\"],Resource=aws_secretsmanager_secret.dburl.arn}]})}"
      }
    },
    "aws_lb": {
      "main": {
        "name": "pilaf-staging",
        "load_balancer_type": "application",
        "security_groups": [
          "${aws_security_group.alb.id}"
        ],
        "subnets": [
          "${aws_subnet.public0.id}",
          "${aws_subnet.public1.id}"
        ],
        "drop_invalid_header_fields": true
      }
    },
    "aws_lb_target_group": {
      "main": {
        "name": "pilaf-staging",
        "port": 3000,
        "protocol": "HTTP",
        "target_type": "ip",
        "vpc_id": "${aws_vpc.main.id}",
        "health_check": {
          "path": "/api/health",
          "matcher": "200"
        }
      }
    },
    "aws_lb_listener": {
      "https": {
        "load_balancer_arn": "${aws_lb.main.arn}",
        "port": 443,
        "protocol": "HTTPS",
        "certificate_arn": "${var.certificate_arn}",
        "ssl_policy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "default_action": {
          "type": "forward",
          "target_group_arn": "${aws_lb_target_group.main.arn}"
        }
      },
      "http": {
        "load_balancer_arn": "${aws_lb.main.arn}",
        "port": 80,
        "protocol": "HTTP",
        "default_action": {
          "type": "redirect",
          "redirect": {
            "port": "443",
            "protocol": "HTTPS",
            "status_code": "HTTP_301"
          }
        }
      }
    },
    "aws_ecs_task_definition": {
      "web": {
        "count": "${var.enable_service ? 1 : 0}",
        "family": "pilaf-staging",
        "requires_compatibilities": [
          "FARGATE"
        ],
        "network_mode": "awsvpc",
        "cpu": "512",
        "memory": "1024",
        "execution_role_arn": "${aws_iam_role.execution.arn}",
        "container_definitions": "[{\"name\": \"web\", \"image\": \"${var.image}\", \"essential\": true, \"portMappings\": [{\"containerPort\": 3000}], \"environment\": [{\"name\": \"APP_ORIGIN\", \"value\": \"${var.app_origin}\"}, {\"name\": \"ACCOUNTS_ENABLED\", \"value\": \"false\"}, {\"name\": \"TEST_CHECKOUT_ENABLED\", \"value\": \"false\"}, {\"name\": \"WHOLESALE_ENABLED\", \"value\": \"false\"}, {\"name\": \"EMAIL_ENABLED\", \"value\": \"false\"}, {\"name\": \"PGSSLMODE\", \"value\": \"verify-full\"}, {\"name\": \"NODE_EXTRA_CA_CERTS\", \"value\": \"/app/rds-ca.pem\"}], \"secrets\": [{\"name\": \"DATABASE_URL\", \"valueFrom\": \"${aws_secretsmanager_secret.dburl.arn}\"}], \"logConfiguration\": {\"logDriver\": \"awslogs\", \"options\": {\"awslogs-group\": \"${aws_cloudwatch_log_group.main.name}\", \"awslogs-region\": \"${var.region}\", \"awslogs-stream-prefix\": \"web\"}}}]"
      }
    },
    "aws_ecs_service": {
      "web": {
        "count": "${var.enable_service ? 1 : 0}",
        "name": "pilaf-staging",
        "cluster": "${aws_ecs_cluster.main.id}",
        "task_definition": "${aws_ecs_task_definition.web[0].arn}",
        "desired_count": 1,
        "launch_type": "FARGATE",
        "network_configuration": {
          "subnets": [
            "${aws_subnet.private0.id}",
            "${aws_subnet.private1.id}"
          ],
          "security_groups": [
            "${aws_security_group.app.id}"
          ],
          "assign_public_ip": false
        },
        "load_balancer": {
          "target_group_arn": "${aws_lb_target_group.main.arn}",
          "container_name": "web",
          "container_port": 3000
        },
        "depends_on": [
          "aws_lb_listener.https",
          "aws_iam_role_policy.secret",
          "aws_iam_role_policy_attachment.execution"
        ],
        "health_check_grace_period_seconds": 90,
        "deployment_circuit_breaker": {
          "enable": true,
          "rollback": true
        }
      }
    }
  },
  "output": {
    "alb_dns": {
      "value": "${aws_lb.main.dns_name}"
    },
    "alb_zone_id": {
      "value": "${aws_lb.main.zone_id}"
    },
    "repository": {
      "value": "${aws_ecr_repository.main.repository_url}"
    },
    "db_endpoint": {
      "value": "${aws_db_instance.main.address}"
    },
    "db_secret": {
      "value": "${aws_secretsmanager_secret.dburl.arn}"
    }
  }
}
